er all insertions.</li><li data-ref="76941828-e3ac-4cb1-8edc-bfda4ec32115">The second line displays the space-separated heap contents after performing <mjx-container class="MathJax" jax="CHTML" style="font-size: 113.7%; position: relative;" data-ref="08c9e71f-f049-493e-b260-e127438520bc" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="e5818c62-dee6-4718-9b3e-fca4739738ff"><mjx-mi class="mjx-i" data-ref="9a654b99-d5e8-4a9d-83aa-4d27adc28511"><mjx-c class="mjx-c1D458 TEX-I" data-ref="41e7be58-adeb-48a9-a519-f95effa554b8"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="9a129416-98b0-4f49-9d65-bb4ca608a6c2"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="05619cc8-93d6-4e2e-a3e4-92416522257c"><mi data-ref="69f7b233-4de9-4ce2-8b78-3397a28476e6">k</mi></math></mjx-assistive-mml></mjx-container> deletions of the root element.</li></ul><p data-ref="eb427126-3411-489d-af69-57318371ee5d" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="1acddc99-ef40-48be-9389-82975a72fcc0"></p><p data-ref="e3948593-41cf-402c-aaac-2143d2810ee8" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="a4be1f10-4e9d-4930-ab81-c1adbb7d0dce">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="440bb96a-a458-45e4-8e06-53c069fdaf66"><div class="ml-1 mb-3" data-ref="15b97eab-8e47-4efc-89eb-77d9b99c1336"><b style="border-bottom:1px solid black;" data-ref="ecfead38-38a2-4eb6-8187-1fe800cf3fd3" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="72f6c796-38b5-407d-af17-7701bbc9989d" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="de2c4d21-6399-4e3b-aa7a-37f78943b62d" data-undisplayed="undisplayed">minheap.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="c09335b7-0f55-4489-b795-2991e9ed2c74" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#define MAX_SIZE 20
int heap[MAX_SIZE];
int size = 0;
void swap(int *a, int *b){
    int temp = *a;
    *a = *b;
    *b = temp;
}

void heapifyUp(int index){
    while(index &gt; 0){
        int parent = (index - 1) / 2;
        if(heap[index] &lt; heap[parent]){
            swap(&amp;heap[index], &amp;heap[parent]);
            index = parent;
        }else{
            break;
        }
    }
}

void insert(int value){
    heap[size] = value;
    heapifyUp(size);
    size++;
}

void heapifyDown(int index){
    while(1){
        int left = 2 * index + 1;
        int right = 2 * index + 2;
        int smallest = index;
        if(left &lt; size &amp;&amp; heap[left] &lt; heap[smallest]){
            smallest = left;
        }
        if(right &lt; size &amp;&amp; heap[right] &lt; heap[smallest]){
            smallest = right;
        }
        if(smallest != index){
            swap(&amp;heap[index], &amp;heap[smallest]);
            index = smallest;
        }else{
            break;
        }
    }
}

void deleteMin(){
    if(size == 0) return;
    heap[0] = heap[size - 1];
    size--;
    heapifyDown(0);
}
void printHeap(){
    for(int i = 0; i &lt; size; i++){
        printf("%d ", heap[i]);
    }
}
int main(){
    int n, del, val;
    scanf("%d", &amp;n);
    for(int i = 0; i &lt; n; i++){
        scanf("%d", &amp;val);
        insert(val);
    }
    printHeap();
    scanf("%d\n", &amp;del);
    for(int i = 0; i &lt; del; i++){
        deleteMin();
    }
    printHeap();
    printf("\n");
    return 0;
}</pre><br data-ref="2f6b1119-e79a-4f98-b8f6-67e4d4dab964"></div></div><div class="row" data-ref="f1f6d7b5-69cb-4763-acef-7b526fd14f7a"><div class="col-12" data-ref="e21a689c-ed95-43c6-a8cd-5dfeeb985ec8"><h5 class="execResultsHeading text-center" data-ref="69bf18aa-b5a4-4792-8265-602590c3ce2e">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="41d4e65b-7bdf-487c-bb93-5fd4a592274b" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="f6032a46-793f-4f66-b9ce-c66afe2aae19"><div class="row execution-results-border" data-ref="10bdff3b-2129-403c-bfe2-312fd24b9535"><div class="col-12 p-2 text-center font-weight-bold" data-ref="b4523d4b-8927-4084-bbbc-1244bfc573bd">Test Case - 1</div></div><div class="row execution-results-border" data-ref="36d97185-8704-4eae-834d-34b90b2f4311"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="dbd33fb5-b434-48a0-bb44-1b7667883a22">User Output</div></div><div class="row execution-results-border" data-ref="b713abf6-d862-478e-b1c6-05817ff0c2bf"><div class="col-6" data-ref="a0b706e8-537a-4b09-b47f-813338d7ab39"><span class="cmd" title="User Input" data-ref="ddb6fc03-92f3-412c-a93c-294c672fde2b">5</span></div></div><div class="row execution-results-border" data-ref="7a95c0ae-7184-45b9-bf23-c9ca49633706"><div class="col-6" data-ref="b7038a70-ccfc-46c6-ac03-a6c0c994bde5"><span class="cmd" title="User Input" data-ref="246e104c-4796-45ec-abd4-d6c32f491bd2">20 15 30 5 10</span></div></div><div class="row execution-results-border" data-ref="96713178-6824-4573-b6d0-139b1e5e6907"><div class="col-6" data-ref="91f57bbc-b1dd-43bb-82a2-88a71111f6bb"><span class="cmd" title="User Input" data-ref="44dbe106-fb1b-4b61-9244-3453a8dc50b4">2</span></div></div><div class="row execution-results-border" data-ref="fade9c80-1ca9-4c02-90da-8e6b85c63b87"><div class="col-12" data-ref="1c179f7d-0db5-44d6-ac3e-4f645405221b"><pre class="outputPre" data-ref="66