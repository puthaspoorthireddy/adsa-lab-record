reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="75eeb117-3a87-4111-b460-59ed623ffca9">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="c1d458ee-90d8-4861-98a7-24c4fde2e88a"><div class="ml-1 mb-3" data-ref="45aa0193-63b4-480f-8c7f-741ff68b9eba"><b style="border-bottom:1px solid black;" data-ref="6fcb982d-080d-407c-bfa3-f14c9e6f27b9" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="1031c1e5-dab3-496e-9858-cc89f8ddf5eb" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="fc4d50d4-3a71-4cce-80df-0929275b4e83" data-undisplayed="undisplayed">Path.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="ae1885f6-d804-4666-b73d-2b0707ed127e" data-undisplayed="undisplayed">// write your code here...
#include &lt;stdio.h&gt;
#include &lt;limits.h&gt;
#define MAX 100
#define INF INT_MAX
int n, m;
int graph[MAX][MAX]; // adjacency matrix
// Function to find vertex with minimum distance not yet visited
int minDistance(int dist[], int visited[]) {
    int min = INF, min_index = -1;
    for (int v = 0; v &lt; n; v++) {
        if (!visited[v] &amp;&amp; dist[v] &lt;= min) {
            min = dist[v];
            min_index = v;
        }
    }
    return min_index;
}
void dijkstra(int src) {
    int dist[MAX];
    int visited[MAX];
    // Initialize distances
    for (int i = 0; i &lt; n; i++) {
        dist[i] = INF;
        visited[i] = 0;
    }
    dist[src] = 0;
    // Process all vertices
    for (int count = 0; count &lt; n - 1; count++) {
        int u = minDistance(dist, visited);
        if (u == -1) break; // no more reachable vertices
        visited[u] = 1;
        // Update neighbors
        for (int v = 0; v &lt; n; v++) {
            if (!visited[v] &amp;&amp; graph[u][v] != INF &amp;&amp;
                dist[u] != INF &amp;&amp;
                dist[u] + graph[u][v] &lt; dist[v]) {
                dist[v] = dist[u] + graph[u][v];
            }
        }
    }
    // Print results
    for (int i = 0; i &lt; n; i++) {
        if (dist[i] == INF)
            printf("%d -1\n", i); // unreachable
        else
            printf("%d %d\n", i, dist[i]);
    }
}
int main() {
    scanf("%d %d", &amp;n, &amp;m);
    // Initialize adjacency matrix
    for (int i = 0; i &lt; n; i++)
        for (int j = 0; j &lt; n; j++)
            graph[i][j] = INF;
    // Input edges
    for (int i = 0; i &lt; m; i++) {
        int u, v, w;
        scanf("%d %d %d", &amp;u, &amp;v, &amp;w);
        graph[u][v] = w; // directed graph
    }
    int src;
    scanf("%d", &amp;src);
    dijkstra(src);
    return 0;
}</pre><br data-ref="178ca9f9-f2f5-4674-a428-71e16c709c3d"></div></div><div class="row" data-ref="0dcb628d-95ae-498c-827c-af41dd93eb83"><div class="col-12" data-ref="5524779a-bbac-4483-b749-17eb2218cc01"><h5 class="execResultsHeading text-center" data-ref="31fa1c66-9224-4d5d-a142-042b30dff499">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="18b514ef-96b4-4fa3-af58-511dc4763ae7" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="e17d9489-57f1-402b-8a36-06234179c4d1"><div class="row execution-results-border" data-ref="83430402-36a6-430f-aa63-b9023f2219be"><div class="col-12 p-2 text-center font-weight-bold" data-ref="39ece763-5558-40c2-a4aa-f7a96faaad43">Test Case - 1</div></div><div class="row execution-results-border" data-ref="b2834990-9c93-4ffd-a5c6-100096453949"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="a1d83581-d3c9-4906-9bb6-95189c7c7f58">User Output</div></div><div class="row execution-results-border" data-ref="3844ad60-e289-45a6-bf99-6d822ad4eb6b"><div class="col-6" data-ref="7cd6be89-6e30-4408-971c-aad6c64b0681"><span class="cmd" title="User Input" data-ref="818fcf23-ccf0-4949-8f9f-19b039d19da1">4 3</span></div></div><div class="row execution-results-border" data-ref="596e27d2-9c0f-41fd-9d16-43b60d5bd435"><div class="col-6" data-ref="d4d9f7bc-dcba-4c31-9cf2-641533284682"><span class="cmd" title="User Input" data-ref="19df49af-b031-4c21-841b-dd2fb19b1ce4">0 1 2</span></div></div><div class="row execution-results-border" data-ref="4f3f6c03-2370-43c9-9ac2-54c0ee902d7c"><div class="col-6" data-ref="a3d0c4aa-c05b-415b-9263-5e830622b40e"><span class="cmd" title="User Input" data-ref="acf48330-3060-4bd6-b458-b55d0ef69c01">0 2 5</span></div></div><div class="row execution-results-border" data-ref="de1a9e95-c004-40b3-9d4b-f5509bd54f1e"><div class="col-6" data-ref="d449c93e-ae84-4879-a96f-182c60bbeb78"><span class="cmd" title="User Input" d