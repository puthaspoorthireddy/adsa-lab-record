int adjCount[MAX];     // Number of neighbors for each node
int visited[MAX];      // Visited array
int queue[MAX];        // Queue for BFS
int front = 0, rear = 0;
// Comparison function for sorting neighbors
int compare(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}
// Enqueue operation
void enqueue(int v) {
    queue[rear++] = v;
}
// Dequeue operation
int dequeue() {
    return queue[front++];
}
// Check if queue is empty
int isEmpty() {
    return front == rear;
}
// BFS function
void bfs(int start) {
    visited[start] = 1;
    enqueue(start);
    while (!isEmpty()) {
        int current = dequeue();
        printf("%d ", current);
        for (int i = 0; i &lt; adjCount[current]; i++) {
            int neighbor = adj[current][i];
            if (!visited[neighbor]) {
                visited[neighbor] = 1;
                enqueue(neighbor);
            }
        }
    }
}
int main() {
    int vertices, edges;
    scanf("%d %d", &amp;vertices, &amp;edges);
    // Initialize structures
    for (int i = 0; i &lt; vertices; i++) {
        adjCount[i] = 0;
        visited[i] = 0;
    }
    // Input edges
    for (int i = 0; i &lt; edges; i++) {
        int u, v;
        scanf("%d %d", &amp;u, &amp;v); // directed edge u â†’ v
        adj[u][adjCount[u]++] = v;
    }
    // Sort neighbors for each vertex
    for (int i = 0; i &lt; vertices; i++) {
        qsort(adj[i], adjCount[i], sizeof(int), compare);
    }
    int start;
    scanf("%d", &amp;start);
    // Perform BFS
    bfs(start);
    return 0;
}</pre><br data-ref="1598bc87-8c4e-439f-965f-959fe5e87346"></div></div><div class="row" data-ref="00ede8ee-b83e-41d8-9d90-c3085b720e5e"><div class="col-12" data-ref="298637ef-77f6-4266-96b5-96b727c51b60"><h5 class="execResultsHeading text-center" data-ref="f6ebde0a-1e51-4b78-83f1-a4521b6be7da">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="305138d9-935c-49cf-9454-38ddfed17507" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="95653e88-7e58-4854-91c9-13b359ae5cef"><div class="row execution-results-border" data-ref="c3d3837b-96c9-4130-85a3-75f3ba420597"><div class="col-12 p-2 text-center font-weight-bold" data-ref="6aae066d-73b7-4a44-908d-27f5005a44e3">Test Case - 1</div></div><div class="row execution-results-border" data-ref="3e71bdb1-f49c-4611-b9d1-2ca845f448e4"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="bd3f6e05-ce55-463d-8d4c-fbd7c15e0c1f">User Output</div></div><div class="row execution-results-border" data-ref="6b437af8-facf-41a0-915f-c88b0d925230"><div class="col-6" data-ref="ed117d53-74a1-4b0b-b17b-55dfbc6144ee"><span class="cmd" title="User Input" data-ref="feeab37b-9dd8-43f6-95e6-13a60e48d884">5 4</span></div></div><div class="row execution-results-border" data-ref="8da44c7a-243f-4c49-96ce-4723c13c0130"><div class="col-6" data-ref="390767ef-fa56-4658-a2f4-4aaf2ebd16fa"><span class="cmd" title="User Input" data-ref="bca7f5d7-8d6b-4d91-882f-4fd0246a6262">0 1</span></div></div><div class="row execution-results-border" data-ref="35d1c4ee-e3a0-41c3-9a33-f5d2a378c0bc"><div class="col-6" data-ref="9dda01a7-f263-4b89-86a7-38c0481796b3"><span class="cmd" title="User Input" data-ref="415ba290-55f0-459e-a5a2-0e4f134a54de">0 2</span></div></div><div class="row execution-results-border" data-ref="1d3c677a-f6ff-4ecc-af76-a9ada77de785"><div class="col-6" data-ref="e3dfcbb6-a510-4dd5-a39f-de7244a57679"><span class="cmd" title="User Input" data-