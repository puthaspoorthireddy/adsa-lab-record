athJax" jax="CHTML" style="font-size: 113.7%; position: relative;" data-ref="e8b783ee-6a74-4a2c-942f-bb50bddf6f11" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="1a624f73-e428-425f-ab50-a7e9fca780ce"><mjx-mi class="mjx-i" data-ref="5d60a9fb-6fe1-47e4-90ee-57559ac4b7cc"><mjx-c class="mjx-c1D458 TEX-I" data-ref="ee2edaba-bf4b-4965-a47c-e2440e33310b"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="75ab68a4-b237-461a-938d-5578aaa8ba10"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="55a617a9-f1cd-4ba6-9387-3ea4752cb767"><mi data-ref="eac9a690-3811-478d-a34a-2857cd85b5e8">k</mi></math></mjx-assistive-mml></mjx-container> deletions of the root element.</li></ul><p data-ref="f8668186-7cf5-42c6-8ca4-0f6f05736449" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="d522a00d-4cb7-4c7a-9d24-8be0d7971850"></p><p data-ref="bd1d57e5-80ed-458f-9c5f-4dfde3ba4479" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="ded21ebc-f129-407f-9b7c-8152de1e3832">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="b94b8f59-f917-4f7e-a337-d39eea2bf1ce"><div class="ml-1 mb-3" data-ref="14e01b2b-a590-427d-8af3-f615d448e9bd"><b style="border-bottom:1px solid black;" data-ref="30799961-5492-4b34-a5bd-5cccbde316b4" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="fa47922d-5b07-484e-8927-d4d5ac950d6c" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="7c19d7d0-4c45-4af0-9ed2-7f8ea7fb494d" data-undisplayed="undisplayed">maxheap.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="d83c9d75-3e61-4f8b-857f-27ee4694d908" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#define MAX_SIZE 20
int heap[MAX_SIZE];
int size = 0;
void swap(int *a, int *b){
    int temp = *a;
    *a = *b;
    *b = temp;
}
void heapifyup(int index){
    while(index &gt; 0){
        int parent = (index - 1) / 2;
        if(heap[index] &gt; heap[parent]){
            swap(&amp;heap[index], &amp;heap[parent]);
            index = parent;
        } else {
            break;
        }
    }
}

void heapifydown(int index){
    while(index &lt; size){
        int left = 2 * index + 1;
        int right = 2 * index + 2;
        int largest = index;
        if(left &lt; size &amp;&amp; heap[left] &gt; heap[largest]){
            largest = left;
        }
        if(right &lt; size &amp;&amp; heap[right] &gt; heap[largest]){
            largest = right;
        }
        if(largest != index){
            swap(&amp;heap[index], &amp;heap[largest]);
            index = largest;
        } else {
            break;
        }
    }
}

void insert(int value){
    if(size == MAX_SIZE)
        return;
    heap[size] = value;
    size++;
    heapifyup(size - 1);
}

void deleteRoot(){
    if(size == 0) return;
    heap[0] = heap[size - 1];
    size--;
    heapifydown(0);
}

void printheap(){
    for(int i = 0; i &lt; size; i++){
        printf("%d ", heap[i]);
    }
    printf("\n");
}
int main(){
    int n, del, val;
    scanf("%d", &amp;n);
    for(int i = 0; i &lt; n; i++){
        scanf("%d", &amp;val);
        insert(val);
    }
    scanf("%d", &amp;del);
    printheap();
    for(int i = 0; i &lt; del; i++){
        deleteRoot();
    }
    printheap();
    return 0;
}
