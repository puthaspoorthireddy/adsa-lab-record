#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
// Structure for a Job
typedef struct {
    int id;
    int deadline;
    int profit;
} Job;

// Compare function for sorting jobs in descending order of profit
int compare(const void *a, const void *b) {
    Job *j1 = (Job *)a;
    Job *j2 = (Job *)b;
    return j2-&gt;profit - j1-&gt;profit;
}

int main() {
    int n;
    scanf("%d", &amp;n);

    Job jobs[n];
    int i;

    for (i = 0; i &lt; n; i++) {
        scanf("%d %d %d", &amp;jobs[i].id, &amp;jobs[i].deadline, &amp;jobs[i].profit);
    }

    // Sort jobs by profit in descending order
    qsort(jobs, n, sizeof(Job), compare);

    // Find maximum deadline
    int maxDeadline = 0;
    for (i = 0; i &lt; n; i++) {
        if (jobs[i].deadline &gt; maxDeadline) {
            maxDeadline = jobs[i].deadline;
        }
    }

    // Create slots (all initially free)
    int slot[maxDeadline + 1];
    for (i = 0; i &lt;= maxDeadline; i++) {
        slot[i] = -1;
    }

    int countJobs = 0, totalProfit = 0;

    // Schedule jobs
    for (i = 0; i &lt; n; i++) {
        // Try to schedule in the latest free slot &lt;= deadline
        for (int j = jobs[i].deadline; j &gt; 0; j--) {
            if (slot[j] == -1) {
                slot[j] = jobs[i].id;
                countJobs++;
                totalProfit += jobs[i].profit;
                break;
            }
        }
    }

    printf("%d %d\n", countJobs, totalProfit);
    return 0;
}</pre><br data-ref="8623494d-f91c-4fdd-bfc2-96c9bc8a4079"></div></div><div class="row" data-ref="0c6afc52-76af-4869-9949-71854c45874e"><div class="col-12" data-ref="dd519439-21e5-4326-acfc-2e6f37aef2fe"><h5 class="execResultsHeading text-center" data-ref="6f6c75e3-8597-4a4b-bed5-481073d9a633">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="c6090b73-5d48-4b21-9a46-9a499239244f" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="094f9f43-8153-4bc4-9369-926963db4577"><div class="row execution-results-border" data-ref="320f65bd-7825-4031-a8a8-de1580999b36"><div class="col-12 p-2 text-center font-weight-bold" data-ref="f8e7ea08-007b-4a6e-8678-d9591bc92df1">Test Case - 1</div></div><div class="row execution-results-border" data-ref="e6ad5258-0f93-4189-959d-59a6d30b34f8"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="48ef1b83-ae47-402d-8fd7-535e6b097ecc">User Output</div></div><div class="row execution-results-border" data-ref="ba5b2c08-8a9b-484d-865b-c0f00b56a3c0"><div class="col-6" data-ref="6bf1cf55-efdb-452e-935b-cb68f4ce8f20"><span class="cmd" title="User Input" data-ref="2a618d04-e619-46f7-9f4a-dde699ffff83">4</span></div></div><div class="row execution-results-border" data-ref="4d1530e2-5a85-43d9-9ea9-3e7cee1f8570"><div class="col-6" data-ref="6e787a43-5d65-4526-a47e-5ceace7cf0fc"><span class="cmd" title="User Input" data-ref="cfef840b-7577-40cf-b28b-db19c9501cab">1 4 20</span></div></div><div class="row execution-results-border" data-ref="edf3b4bc-281b-4107-85c0-889fea158553"><div class="col-6" data-ref="2b3372c9-0513-449b-a1b1-064541ef8cc8"><span class="cmd" title="User Input" data-ref="40f9e759-d7ab-40e2-9807-098014c1d49e">2 1 10</span></div></div><div class="row execution-results-border" data-ref="77d03bc0-64e1-4b9d-9aa8-7771ad487971"><div class="col-6" data-ref="2bb4ce57-7724-461c-bafa-4ffaca6577f0"><span class="cmd" title="User Input" d