list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="b6d52c95-326d-4631-b77c-c1e1f5ebcc47">Output Format:</strong></p><ul data-ref="5c679e14-d482-490c-a7c4-f5e9376666d1" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="29f91e9e-7370-437b-b4f2-aa6298d40640">Print the maximum profit (total value) that can be obtained by selecting items, considering the knapsack's capacity constraint.</li></ul><p data-ref="bf790ff8-edac-4026-ae13-e69872fdfef3" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="470befc4-7f9f-4d57-a1f3-4f7f332f576d"></p><p data-ref="c9fc3f4e-ffd3-4375-9e8c-3f9f86ffdb1d" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="327ccccc-d383-4b9c-a5fa-447e2faf01b1">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="c1f1015d-ab6a-4f1e-b4c7-eb0154838e36"><div class="ml-1 mb-3" data-ref="93f5584a-4aac-4c19-a1ee-f00e443a46d3"><b style="border-bottom:1px solid black;" data-ref="15059a08-0ed4-45b6-a90c-4ea8475e4b49" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="a11f139c-1401-4606-a674-c604ebe42486" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="ca55fd33-9379-470f-802c-c08f4b2f53dc" data-undisplayed="undisplayed">knapsackBacktracking.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="f1720705-b320-40a0-b870-4e4e27f3c553" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;

int n, W;
int maxProfit = 0;
int value[100], weight[100];

void Knapsack(int i, int cw, int cv) {
    if (i == n) {
        if (cv &gt; maxProfit) {
            maxProfit = cv;
        }
        return;
    }
    
    if (cw + weight[i] &lt;= W) {
        Knapsack(i + 1, cw + weight[i], cv + value[i]);
    }
    
    Knapsack(i + 1, cw, cv);
}

int main() {
    scanf("%d", &amp;n);
    
    for (int i = 0; i &lt; n; i++) {
        scanf("%d %d", &amp;value[i], &amp;weight[i]);
    }
    
    scanf("%d", &amp;W);
    
    Knapsack(0, 0, 0);
    
    printf("%d\n", maxProfit);
    
    return 0;
}
