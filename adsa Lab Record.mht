				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="4ec098dc-cbef-42a4-8c03-a6ba9da4b05f" data-split-from="4ec098dc-cbef-42a4-8c03-a6ba9da4b05f" data-split-to="4ec098dc-cbef-42a4-8c03-a6ba9da4b05f"><div class="page" data-ref="61c65111-18d8-4c15-9908-9ad4d336b105" data-split-from="61c65111-18d8-4c15-9908-9ad4d336b105" data-split-to="61c65111-18d8-4c15-9908-9ad4d336b105"><div data-ref="13e963a9-f069-47c8-b8b7-1fabbdca7b71" data-id="lab-print" data-split-from="13e963a9-f069-47c8-b8b7-1fabbdca7b71" data-split-to="13e963a9-f069-47c8-b8b7-1fabbdca7b71"><div class="ct-print-new-page-after-always" data-ref="195b67e0-7d32-45f3-a034-57546d157835" data-break-after="always" data-split-from="195b67e0-7d32-45f3-a034-57546d157835" data-split-to="195b67e0-7d32-45f3-a034-57546d157835"><div class="mb-3" data-ref="c1f1015d-ab6a-4f1e-b4c7-eb0154838e36" data-split-from="c1f1015d-ab6a-4f1e-b4c7-eb0154838e36"><div class="user-solution" style="page-break-inside: auto" data-ref="a11f139c-1401-4606-a674-c604ebe42486" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="ca55fd33-9379-470f-802c-c08f4b2f53dc" data-undisplayed="undisplayed">knapsackBacktracking.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="f1720705-b320-40a0-b870-4e4e27f3c553" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;

int n, W;
int maxProfit = 0;
int value[100], weight[100];

void Knapsack(int i, int cw, int cv) {
    if (i == n) {
        if (cv &gt; maxProfit) {
            maxProfit = cv;
        }
        return;
    }
    
    if (cw + weight[i] &lt;= W) {
        Knapsack(i + 1, cw + weight[i], cv + value[i]);
    }
    
    Knapsack(i + 1, cw, cv);
}

int main() {
    scanf("%d", &amp;n);
    
    for (int i = 0; i &lt; n; i++) {
        scanf("%d %d", &amp;value[i], &amp;weight[i]);
    }
    
    scanf("%d", &amp;W);
    
    Knapsack(0, 0, 0);
    
    printf("%d\n", maxProfit);
    
    return 0;
}
