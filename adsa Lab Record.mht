d960b2-d63c-45de-9c4d-ef071321c264"><mi data-ref="5cc8a7ca-1cd2-48b1-b836-cc9d17821f68">u</mi></math></mjx-assistive-mml></mjx-container> <mjx-container class="MathJax" jax="CHTML" style="font-size: 113.7%; position: relative;" data-ref="c9d2666e-c717-42cb-a983-6a08aa3448d1" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="500b1beb-70e7-4e10-8744-16dbb07c1fef"><mjx-mi class="mjx-i" data-ref="6201722f-e84b-47a1-94ff-66b7987c0e53"><mjx-c class="mjx-c1D463 TEX-I" data-ref="ac07b09c-fdb9-4164-be67-21ac7561153b"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="8ff3e71f-faa3-4133-815e-3c802c264481"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="0b9968e8-bd90-4e25-9fad-6fa3e46d3cbd"><mi data-ref="3128ac8d-9144-4f1f-a3c5-5cbab26be32d">v</mi></math></mjx-assistive-mml></mjx-container> as space separated integers for each edge.</li></ul><p data-ref="4f8ea3fd-6e18-4024-9331-40f6cc7ff91c" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="79341535-c56f-42b5-ac73-63d8b2952f85"></p><p data-ref="d43576d2-4024-4175-b8f3-266bd8c1c780" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="da9d8561-3f72-49eb-92fd-ffab3bc6e853">Output Format:</strong></p><ul data-ref="29218b9d-a0cb-4a8b-9bf7-de76eec22d34" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="d33ff865-80dd-4340-8be1-a91625f17f3d">The code will print the number of biconnected components found in the graph.</li></ul><p data-ref="b67ba470-de90-4bf5-bdcc-b5f0d8df4dfb" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="077fcb30-e9cd-4573-8940-2f4b4947798a"></p><p data-ref="7fb341f6-8bf6-4bac-8826-489d686a99af" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="07bf4113-9820-4b40-a2e4-6404cebc798c">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="af917ce7-c8d6-4e5e-8330-ea95cb6dd80a"><div class="ml-1 mb-3" data-ref="c4612a22-bf2f-4c4f-9ef2-6e4a2701a120"><b style="border-bottom:1px solid black;" data-ref="39b0d53a-489c-456f-8d50-3ca78baa9667" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="48ddf388-b29c-4623-947b-0e1e395efddc" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="5489e43a-2576-4215-a605-bd60e03ca451" data-undisplayed="undisplayed">biConnected.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="cbc8adb9-fc7a-43c4-99aa-2da5d3713783" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;

#define MAX 1000

int adj[MAX][MAX];
int disc[MAX], low[MAX], parent[MAX];
int stackU[MAX*MAX], stackV[MAX*MAX];
int top = -1;
int timer = 0, components = 0;

void push(int u, int v) {
    stackU[++top] = u;
    stackV[top] = v;
}

void dfs(int u, int n) {
    disc[u] = low[u] = ++timer;
    int children = 0;
    
    for (int v = 0; v &lt; n; v++) {
        if (!adj[u][v]) 
            continue;
            
        if (disc[v] == 0) {
            children++;
            parent[v] = u;
            push(u, v);
            dfs(v, n);
            
            if (low[v] &lt; low[u]) {
                low[u] = low[v];
            }
            
            if ((parent[u] == -1 &amp;&amp; children &gt; 1) || (parent[u] != -1 &amp;&amp; low[v] &gt;= disc[u])) {
                components++;
                while (top &gt;= 0) {
                    int a = stackU[top];
                    int b = stackV[top--];
                    if (a == u &amp;&amp; b == v) {
                        break;
                    }
                }
            }
        } 
        else if (v != parent[u] &amp;&amp; disc[v] &lt; disc[u]) {
            push(u, v);
            if (disc[v] &lt; low[u]) {
                low[u] = disc[v];
            }
        }
    }
}

int main() {
    int n, m, u, v;
    
    scanf("%d", &amp;n);
    scanf("%d", &amp;m);
    
    for (int i = 0; i &lt; n; i++) {
        for (int j = 0; j &lt; n; j++) {
            adj[i][j] = 0;
        }
    }
    
    for (int i = 0; i &lt; m; i++) {
        scanf("%d %d", &amp;u, &amp;v);
        adj[u][v] = 1;
        adj[v][u] = 1;
    }
    
    for (int i = 0; i &lt; n; i++) {
        disc[i] = 0;
        low[i] = 0;
        parent[i] = -1;
    }
    
    for (int i = 0; i &lt; n; i++) {
        if (disc[i] == 0) {
            dfs(i, n);
            if (top &gt;= 0) {
                components++;
                top = -1;
            }
        }
    }
    
    printf("%d\n", components);
    
