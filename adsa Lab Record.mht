int main() {
    int n, W;
    scanf("%d", &amp;n);
    
    int weight[n], value[n];
    
    for (int i = 0; i &lt; n; i++) {
        scanf("%d", &amp;weight[i]);
    }
    
    for (int i = 0; i &lt; n; i++) {
        scanf("%d", &amp;value[i]);
    }
    
    scanf("%d", &amp;W);
    
    int dp[W + 1];
    
    for (int w = 0; w &lt;= W; w++) {
        dp[w] = 0;
    }
    
    for (int i = 0; i &lt; n; i++) {
        for (int w = W; w &gt;= weight[i]; w--) {
            if (value[i] + dp[w - weight[i]] &gt; dp[w]) {
                dp[w] = value[i] + dp[w - weight[i]];
            }
        }
    }
    
    printf("%d\n", dp[W]);
    
    return 0;
}
