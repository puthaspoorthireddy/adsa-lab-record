<div class="container-xl" data-ref="4ec098dc-cbef-42a4-8c03-a6ba9da4b05f"><header class="text-right" data-ref="7f92d8f6-d75e-426a-9477-ebfd5b88c810"> </header> <div class="page" data-ref="61c65111-18d8-4c15-9908-9ad4d336b105"><div id="lab-print" data-ref="13e963a9-f069-47c8-b8b7-1fabbdca7b71" data-id="lab-print"><div class="ct-print-new-page-after-always" data-ref="747d55ee-4c75-40d0-b8fa-af26cfafa965" data-break-after="always"><div data-ref="09bbd4bb-1d6b-46cd-b160-6a3328fca4dc"><table class="table table-condensed table-bordered table-hover" data-ref="46a4acd8-b9c7-4fe8-ae20-469d8f344412"><thead data-ref="d5d5d272-c1d0-472d-86d2-227a445d5017"><tr data-ref="b9096da3-b008-46eb-8db7-05e92c2ba55f"><th class="text-left align-middle" style="width:20%" data-ref="334f5ca8-b93b-467e-bcb5-a58a6ed6dec9" data-undisplayed="undisplayed">S.No: 1</th> <th class="text-left align-middle" style="width:55%; font-weight: normal;" data-ref="67c40a3b-64e8-45f1-815e-6bd82d3e2711" data-undisplayed="undisplayed">Exp. Name: <b class="expTitle" data-ref="bb50a82e-d0d0-4374-937b-f6437363c1fd"><i data-ref="0f26db49-11f8-4d14-ab85-b13eee30a022">Program to implement AVL tree and its operations</i></b></th> <th class="text-left align-middle" style="width:25%" data-ref="b627781e-a4a5-4d4a-8c31-a2d6e56dd6bc" data-undisplayed="undisplayed">Date: 2026-10-12</th></tr></thead></table></div><div class="ml-1" style="page-break-inside: auto" data-ref="452d9eca-cdb3-46a6-a738-e8891bb57988" data-undisplayed="undisplayed"><b style="border-bottom:1px solid black;" data-ref="0a8806e5-1073-477a-aca7-865a5a9ec024" data-undisplayed="undisplayed">Aim:</b><br data-ref="fda79475-27db-4f20-9141-b9096eea3b92"> <span class="question-text ql-editor" data-ref="641219ab-9de5-4515-868d-296ceb6ff207"><p data-ref="b898d943-8d47-44b2-954d-95dd1bd4fd5c" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0">Write a program to create an AVL tree using a provided set of elements stored in a file. Implement operations for inserting and deleting elements from the AVL tree. After constructing the tree, output the contents of the tree in in-order traversal to a new file.</p><p data-ref="ab5dbf27-1d4b-416b-9e70-a095c94a42d3" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="525d8417-697c-4ef4-9655-42796bce66a7"></p><p data-ref="a6278623-ccd6-4726-8621-076b1ba84de4" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="015bb7d4-a887-4180-80c5-9c4160b02310">Note: </strong>Refer to visible test cases for better understanding.</p></span></div><div class="mb-3" data-ref="13e01e25-ae61-438c-a54a-7fdee0ad5e38"><div class="ml-1 mb-3" data-ref="4d44c18d-556b-4ff5-86a5-0087f97bdf77"><b style="border-bottom:1px solid black;" data-ref="b9f9756d-334c-4017-a3a8-53112cc1be0b" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="6e5aa9d0-45ae-4b86-9eef-d9d2f4902cd3" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="50313a67-5759-4be0-b5f9-3412757a086c" data-undisplayed="undisplayed">avl_tree.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="12f88500-4655-4ac7-9e02-6f2bfd9d49ec" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;string.h&gt;
#include &lt;stdbool.h&gt;
typedef struct Node {
    int key;
    struct Node* left;
    struct Node* right;
    int height;
} Node;
// Utility functions
int height(Node* N) {
    if (N == NULL) return 0;
    return N-&gt;height;
}
/*The max() function helps us find which subtree (left or right) is taller. Since the height of a node depends on the longest path from that node to a leaf, we take the maximum of the left and right subtree heights*/
int max(int a, int b) {
    return (a &gt; b) ? a : b;
}

Node* newNode(int key) {
    Node* node = (Node*)malloc(sizeof(Node));
    node-&gt;key = key;
    node-&gt;left = node-&gt;right = NULL;
    node-&gt;height = 1;
    return node;
}
//example insert 50(50 is key ,its height is initialized with 1)
// Rotations
//LL imbalance
Node* rightRotate(Node* y) {
    Node* x = y-&gt;left;
    Node* T2 = x-&gt;right;
    x-&gt;right = y;
    y-&gt;left = T2;
    y-&gt;height = max(height(y-&gt;left), height(y-&gt;right)) + 1;
    x-&gt;height = max(height(x-&gt;left), height(x-&gt;right)) + 1;
    return x;
}
Node* leftRotate(Node* x) {
    Node* y = x-&gt;right;
    Node* T2 = y-&gt;left;
    y-&gt;left = x;
    x-&gt;right = T2;
    x-&gt;height = max(height(x-&gt;left), height(x-&gt;right)) + 1;
    y-&gt;height = max(height(y-&gt;left), height(y-&gt;right)) + 1;
    return y;
}
int getBalance(Node* N) {
    if (N == NULL) return 0;
    return height(N-&gt;left) - height(N-&gt;right);
}
// Insert
Node* insert(Node* node, int key) {
    if (node == NULL)
        return newNode(key);
    if (key &lt; node-&gt;key)
        node-&gt;left = insert(node-&gt;left, key);
    else if (key &gt; node-&gt;key)
        node-&gt;right = insert(node-&gt;right, key);
    else
        return node; // No duplicates
    node-&gt;height = 1 + max(height(node-&gt;left), height(node-&gt;right));
    int balance = getBalance(node);
    // Balancing
//LL IMBALANCE
    if (balance &gt; 1 &amp;&amp; key &lt; node-&gt;left-&gt;key) return rightRotate(node);
//RR imbalance
    if (balance &lt; -1 &amp;&amp; key &gt; node-&gt;right-&gt;key) return leftRotate(node);
//LR IMBALANCE
    if (balance &gt; 1 &amp;&amp; key &gt; node-&gt;left-&gt;key) {
        node-&gt;left = leftRotate(node-&gt;left);
        return rightRotate(node);
    }
//RL IMBALANCE
    if (balance &lt; -1 &amp;&amp; key &lt; node-&gt;right-&gt;key) {
        node-&gt;right = rightRotate(node-&gt;right);
        return leftRotate(node);
    }
    return node;
}
// Minimum value node
Node* minValueNode(Node* node) {
    Node* current = node;
    while (current-&gt;left)
        current = current-&gt;left;
    return current;
}
// Delete
Node* deleteNode(Node* root, int key, int* found) {
    if (!root) return root;
    if (key &lt; root-&gt;key)
        root-&gt;left = deleteNode(root-&gt;left, key, found);
    else if (key &gt; root-&gt;key)
        root-&gt;right = deleteNode(root-&gt;right, key, found);
    else {
        *found = 1;
        if (!root-&gt;left || !root-&gt;right) {
            Node* temp = root-&gt;left ? root-&gt;left : root-&gt;right;
            if (!temp) {
                temp = root;
                root = NULL;
            } else
                *root = *temp;
            free(temp);
        } else {
            Node* temp = minValueNode(root-&gt;right);
            root-&gt;key = temp-&gt;key;
            root-&gt;right = deleteNode(root-&gt;right, temp-&gt;key, found);
        }
    }
    if (!root) return root;
    root-&gt;height = 1 + max(height(root-&gt;left), height(root-&gt;right));
    int balance = getBalance(root);
    if (balance &gt; 1 &amp;&amp; getBalance(root-&gt;left) &gt;= 0) return rightRotate(root);
    if (balance &gt; 1 &amp;&amp; getBalance(root-&gt;left) &lt; 0) {
        root-&gt;left = leftRotate(root-&gt;left);
        return rightRotate(root);
    }
    if (balance &lt; -1 &amp;&amp; getBalance(root-&gt;right) &lt;= 0) return leftRotate(root);
    if (balance &lt; -1 &amp;&amp; getBalance(root-&gt;right) &gt; 0) {
        root-&gt;right = rightRotate(root-&gt;right);
        return leftRotate(root);
    }
    return root;
}
// In-order traversal
void inorder(Node* root, FILE* out) {
    if (root) {
        inorder(root-&gt;left, out);
        fprintf(out, "%d ", root-&gt;key);
        inorder(root-&gt;right, out);
    }
}
void printInorder(Node* root) {
    FILE* temp = tmpfile();
    inorder(root, temp);
    rewind(temp);
    int x;
    while (fscanf(temp, "%d", &amp;x) == 1) {
        printf("%d ", x);
    }
    printf("\n");
    fclose(temp);
}
// Main Program
int main() {
    Node* root = NULL;
    char inputFile[20];
    printf("Input file name: ");
    scanf("%s", inputFile);
//lets say input file contains 10 20 30 40 50
    FILE* in = fopen(inputFile, "r");
    if (!in) {
        printf("Error opening input file\n");
        return 1;
    }
    int val;
	char line[256];
	fgets(line, sizeof(line), in);
	while (fscanf(in, "%d", &amp;val) != EOF)
        root = insert(root, val);
    fclose(in);
    printf("In-order traversal:\n");
    printInorder(root);
    int choice, key;
    while (1) {
        printf("1. Insert\n2. Delete\n3. Write to file and exit\nChoice: ");
        scanf("%d", &amp;choice);
        switch (choice) {
            case 1:
                printf("Element: ");
                scanf("%d", &amp;key);
                root = insert(root, key);
                printf("In-order traversal:\n");
                printInorder(root);
                break;
            case 2:
                printf("Element: ");
                scanf("%d", &amp;key);
                    int found = 0;
                    root = deleteNode(root, key, &amp;found);
                    if (found)
                        printf("Deleted %d\n", key);
                    else
                        printf("%d not found\n", key);
                    printf("In-order traversal:\n");
                    printInorder(root);
                    break;
            case 3:{
                    char outputFile[100];
                    printf("Output file name: ");
                    scanf("%s", outputFile);
                    FILE* out = fopen(outputFile, "w");
                    if (!out) {
                        printf("Error opening output file\n");
                        return 1;
                    }
                    inorder(root, out);
                    fprintf(out, "\n");
                    fclose(out);
                    printf("AVL Tree written to file\n");
                    return 0;}
                default:
                printf("Invalid choice\n");
        }
    }
}</pre><br data-ref="07da21e1-ce37-408f-a8f0-ac1a09d139de"></div><div class="user-solution" style="page-break-inside: auto" data-ref="828e890a-6e63-443f-a5b7-341f80622b36" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="e8c3c365-5067-4ad5-a5f4-9db0d4043ce7" data-undisplayed="undisplayed">input1.txt</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="73323bae-ca84-4592-a44e-875093ab3c62" data-undisplayed="undisplayed">5
