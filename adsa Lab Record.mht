ata-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="e1588ce5-6d83-485a-b677-95bba5fc2771">If a solution exists, print an <mjx-container class="MathJax" jax="CHTML" style="font-size: 113.7%; position: relative;" data-ref="8d372268-7885-4767-bd3c-5541e3ff1d96" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="bd9f628c-9afb-4004-9f57-e28cc94859a3"><mjx-mi class="mjx-i" data-ref="66c98333-550c-48fc-8ee8-83c5efb7c064"><mjx-c class="mjx-c1D441 TEX-I" data-ref="92034cd4-e4fa-4ea3-a983-9a4bd5341a77"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="7aa63e52-96d5-410c-ad90-0d9076b6abf4"><mjx-c class="mjx-cD7" data-ref="b5238681-9f5f-40c2-b095-2dc6470d04e3"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="675cd36d-d199-4e5e-98bc-027e19ac633f"><mjx-c class="mjx-c1D441 TEX-I" data-ref="1d533c04-ce7d-4d33-8f94-8bfd8badff59"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="0f64147c-cb6f-4b52-b5c7-4f1bc8e4ef59"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="f0470c40-4c1a-4b84-bfd0-42a570846603"><mi data-ref="533abbd1-5ddb-4e2a-b63d-b55862735dea">N</mi><mi data-ref="0f5c484e-8d2b-4bb1-8731-638a46f09ebf">Ã—</mi><mi data-ref="3cd22319-3a66-46bb-9d05-dc336495d3c8">N</mi></math></mjx-assistive-mml></mjx-container> matrix consisting of 0s and 1s, where 1 represents a queen.</li><li data-ref="84c6abf9-01ec-401a-8f99-e25254e758c5">If no solution exists, print: "No solution exists for N = &lt;value&gt;".</li><li data-ref="645e7d8c-4b76-45cc-8410-21f36da09092">Each row of the matrix should be printed on a new line, with space-separated values.</li></ul><p data-ref="82e7fd81-8322-4231-95ef-1e61b94c48a0" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="b4bb9168-182c-4ad3-8a1d-d31c98f7137f"></p><p data-ref="8a2969e5-9ed1-45d5-ade1-8619de4739df" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="9f954c79-7e49-4863-b4e6-411b8e522a91">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="5a7c7cca-3e67-4986-a72f-995c065bcb54"><div class="ml-1 mb-3" data-ref="e7734796-b083-4413-96b8-20a8ad6c3718"><b style="border-bottom:1px solid black;" data-ref="eb621289-df15-4b7b-b4ba-73a623100d5c" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="837ac978-9b26-42ae-a483-55f5f6cfd224" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="71cb6baa-f390-437c-a00b-fc2e539b5c22" data-undisplayed="undisplayed">nqueens.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="0fca5c66-164b-4eb2-aaf9-873661b0c43c" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdbool.h&gt;
#define MAX 20

int board[MAX][MAX];

void PrintSolution(int n) {
    for (int i = 0; i &lt; n; i++) {
        for (int j = 0; j &lt; n; j++) {
            printf("%d ", board[i][j]);
        }
        printf("\n");
    }
}

bool isSafe(int row, int col, int n) {
    int i, j;
    
    // Check this column on upper rows
    for (i = 0; i &lt; row; i++) {
        if (board[i][col] == 1)
            return false;
    }
    
    // Check upper diagonal on left side
    for (i = row, j = col; i &gt;= 0 &amp;&amp; j &gt;= 0; i--, j--) {
        if (board[i][j] == 1)
            return false;
    }
    
    // Check upper diagonal on right side
    for (i = row, j = col; i &gt;= 0 &amp;&amp; j &lt; n; i--, j++) {
        if (board[i][j] == 1)
            return false;
    }
    
    return true;
}

bool solveNQueen(int row, int n) {
    if (row == n)
        return true;
        
    for (int col = 0; col &lt; n; col++) {
        if (isSafe(row, col, n)) {
            board[row][col] = 1;
            
            if (solveNQueen(row + 1, n))
                return true;
                
            board[row][col] = 0; // Backtrack
        }
    }
    
    return false;
}

int main() {
    int n;
    scanf("%d", &amp;n);
    
    if (n &lt;= 0 || n &gt; MAX) {
        printf("Invalid board size. Please use N between 1 and %d\n", MAX);
        return 0;
    }
    
    for (int i = 0; i &lt; n; i++) {
        for (int j = 0; j &lt; n; j++) {
            board[i][j] = 0;
        }
    }
    
    if (solveNQueen(0, n)) {
        PrintSolution(n);
    } else {
        printf("No solution exists for N = %d\n", n);
    }
    
    return 0;
}
