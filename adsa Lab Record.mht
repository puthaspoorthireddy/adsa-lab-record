int compare(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}
// Enqueue operation
void enqueue(int v) {
    queue[rear++] = v;
}
// Dequeue operation
int dequeue() {
    return queue[front++];
}
// Check if queue is empty
int isEmpty() {
    return front == rear;
}
// BFS function
void bfs(int start) {
