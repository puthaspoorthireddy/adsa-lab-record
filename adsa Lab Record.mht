dius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="444bf70f-d96a-410f-98c1-56673b9d3c09" data-undisplayed="undisplayed">dfs_directed_graph.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="2ecf6372-c137-4897-afab-ae4420dab2b5" data-undisplayed="undisplayed">//Write your code here..
#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#define MAX 100
int adj[MAX][MAX];  // Adjacency matrix-style list
int visited[MAX];
int adjCount[MAX];  // Number of adjacent vertices for each node
// Comparison function for qsort
int compare(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}
void dfs(int vertex) {
    visited[vertex] = 1;
    printf("%d ", vertex);
    for (int i = 0; i &lt; adjCount[vertex]; i++) {
        int neighbor = adj[vertex][i];
        if (!visited[neighbor]) {
            dfs(neighbor);
        }
    }
}
int main() {
    int vertices, edges;
    scanf("%d %d", &amp;vertices, &amp;edges);
    // Initialize adjacency list and visited array
    for (int i = 0; i &lt; vertices; i++) {
        adjCount[i] = 0;
        visited[i] = 0;
    }
    // Read edges
    for (int i = 0; i &lt; edges; i++) {
        int u, v;
        scanf("%d %d", &amp;u, &amp;v);
        adj[u][adjCount[u]++] = v; // directed edge u â†’ v
    }
    // Sort neighbors to process in increasing order
    for (int i = 0; i &lt; vertices; i++) {
        qsort(adj[i], adjCount[i], sizeof(int), compare);
    }
    int start;
    scanf("%d", &amp;start);
    dfs(start);
    return 0;
}</pre><br data-ref="d5d3be49-aaef-4ee5-80cc-4eddb73be4c2"></div></div><div class="row" data-ref="90979a02-12c4-417c-8f84-d8812b842cd7"><div class="col-12" data-ref="36ca7721-50b7-40b7-a87d-46a7ed8282f1"><h5 class="execResultsHeading text-center" data-ref="782f94bd-6922-4d45-8e06-6e0473b1a579">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="529a18e7-7d5c-4581-8c30-7797b44543fa" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="0b990f1d-1660-4c3e-8ef5-f2f3531f7462"><div class="row execution-results-border" data-ref="83f6e651-9bf3-430d-a176-cbae9f0f777c"><div class="col-12 p-2 text-center font-weight-bold" data-ref="c424d1ca-30cc-43f3-b5b5-df18c6b70f1a">Test Case - 1</div></div><div class="row execution-results-border" data-ref="aa034112-425c-4e1b-b49b-b233696548c9"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="61c2e445-f16a-4d2b-a256-74020e40b08d">User Output</div></div><div class="row execution-results-border" data-ref="e64b9e2d-091c-4bd8-8a5d-9d9db87e598a"><div class="col-6" data-ref="423f955d-88ac-4859-a21a-12221649a21b"><span class="cmd" title="User Input" data-ref="f2616021-51ea-42ca-b86d-7048d8d76f12">5 6</span></div></div><div class="row execution-results-border" data-ref="b640582a-a269-47fe-9525-2f86157eeb7f"><div class="col-6" data-ref="9ae4ecf2-6a04-4ed4-aa0e-f690b8b7c701"><span class="cmd" title="User Input" data-ref="391ef741-7966-4e28-92c2-20047cebe89d">0 1</span></div></div><div class="row execution-results-border" data-ref="1009c6ae-2fb7-4fcf-af94-4a65cb5b2b5f"><div class="col-6" data-ref="0b1d3039-f457-4480-a5f6-ee1fc05e8ef5"><span class="cmd" title="User Input" data-ref="d8a3088a-5921-4dda-aab9-72f994e77b2f">0 2</span></div></div><div class="row execution-results-border" data-ref="dea161d7-d789-4ead-be4d-22c2e3131bab"><div class="col-6" data-ref="48d32bf0-3d91-4f8d-b71b-c02da0adb492"><span class="cmd" title="User Input" data-