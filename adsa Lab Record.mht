reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="ff37c380-fc2f-4713-af1c-025682bdcc13"></p><p data-ref="50de58d4-cad5-4bf1-b2f3-dabee95f4b25" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="919d6b7f-ce87-48c9-a200-ab5989972604">Output Format:</strong></p><ul data-ref="8b86b2fc-ddfd-461c-a7d5-66a4437a7ce8" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="967b7fbb-2d5f-44c0-bbfb-65203ffe74e3">The first line of output should display the inorder traversal of the B-Tree after all insertions, with each key separated by a space.</li><li data-ref="d41b490c-5f78-44ad-8b4c-f3e49b2510b8">The second line should display the inorder traversal of the B-Tree after all deletions, with each key separated by a space.</li><li data-ref="8a583f50-940a-4aa6-ae02-14e8491eb758">The third line should print <strong data-ref="b9f0b48d-f784-4155-b164-edcda453c634">Found</strong> if the search key exists in the B-Tree. If the key is not present, print <strong data-ref="de93ff5a-32ad-4d64-a4e8-3adbf056909d">Not Found</strong> instead.</li></ul><p data-ref="0de3a111-573f-422b-9dec-c37da4b9fbc0" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="e43e5508-6a22-4058-9dfb-2a389446bcfb"></p><p data-ref="cdbc3253-89a6-4f27-91f7-cb7d64adb7c7" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="7b3ec823-baf3-4427-8c39-b4a27eb6de2e"></p><p data-ref="bbb83701-c810-487c-9f3a-a41a41dcb2b5" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="9434fa50-d1b3-40cc-ac78-00aac458e9f5">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="a7ddb997-6fa1-4513-a353-6bd4ec0f5b86"><div class="ml-1 mb-3" data-ref="4d799bd3-a533-4ed7-8770-93ac6ecf1cd1"><b style="border-bottom:1px solid black;" data-ref="95c2502a-8322-44a5-ad2d-c0a12a3f42e2" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="2d480c8f-f558-4af1-8fb3-fe156f655ec6" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="35916055-c212-43be-97fd-4d0ec98ccc32" data-undisplayed="undisplayed">Btreemain.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="965d5ebd-770a-4943-a6d8-4261ebf2d5cc" data-undisplayed="undisplayed">// write your code here..
#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;stdbool.h&gt;

typedef struct BTreeNode {
    int *keys;
    int t;
    struct BTreeNode **C;
    int n;
    bool leaf;
} BTreeNode;

// Create a new node
BTreeNode* createNode(int t, bool leaf) {
    BTreeNode* node = (BTreeNode*)malloc(sizeof(BTreeNode));
    node-&gt;t = t;
    node-&gt;leaf = leaf;
    node-&gt;keys = (int*)malloc((2 * t - 1) * sizeof(int));
    node-&gt;C = (BTreeNode**)malloc((2 * t) * sizeof(BTreeNode*));
    node-&gt;n = 0;
    return node;
}

// Inorder traversal (no trailing dot)
void inorder(BTreeNode* root) {
    if (!root) return;
    for (int i = 0; i &lt; root-&gt;n; i++) {
        if (!root-&gt;leaf)
            inorder(root-&gt;C[i]);
        printf("%d ", root-&gt;keys[i]);
    }
    if (!root-&gt;leaf)
        inorder(root-&gt;C[root-&gt;n]);
}

// Search a key
bool search(BTreeNode* root, int k) {
    int i = 0;
    while (i &lt; root-&gt;n &amp;&amp; k &gt; root-&gt;keys[i])
        i++;
    if (i &lt; root-&gt;n &amp;&amp; root-&gt;keys[i] == k)
        return true;
    if (root-&gt;leaf)
        return false;
    return search(root-&gt;C[i], k);
}

// Split full child
void splitChild(BTreeNode* x, int i) {
    int t = x-&gt;t;
    BTreeNode* y = x-&gt;C[i];
    BTreeNode* z = createNode(t, y-&gt;leaf);
    z-&gt;n = t - 1;
    for (int j = 0; j &lt; t - 1; j++)
        z-&gt;keys[j] = y-&gt;keys[j + t];
    if (!y-&gt;leaf) {
        for (int j = 0; j &lt; t; j++)
            z-&gt;C[j] = y-&gt;C[j + t];
    }
    y-&gt;n = t - 1;
    for (int j = x-&gt;n; j &gt;= i + 1; j--)
        x-&gt;C[j + 1] = x-&gt;C[j];
    x-&gt;C[i + 1] = z;
    for (int j = x-&gt;n - 1; j &gt;= i; j--)
        x-&gt;keys[j + 1] = x-&gt;keys[j];
    x-&gt;keys[i] = y-&gt;keys[t - 1];
    x-&gt;n++;
}

// Insert into non-full node
void insertNonFull(BTreeNode* x, int k) {
    int i = x-&gt;n - 1;
    if (x-&gt;leaf) {
        while (i &gt;= 0 &amp;&amp; k &lt; x-&gt;keys[i]) {
            x-&gt;keys[i + 1] = x-&gt;keys[i];
            i--;
        }
        x-&gt;keys[i + 1] = k;
        x-&gt;n++;
    } else {
        while (i &gt;= 0 &amp;&amp; k &lt; x-&gt;keys[i])
            i--;
        i++;
        if (x-&gt;C[i]-&gt;n == 2 * x-&gt;t - 1) {
            splitChild(x, i);
            if (k &gt; x-&gt;keys[i])
                i++;
        }
        insertNonFull(x-&gt;C[i], k);
    }
}

// Insert key into tree
void insert(BTreeNode** rootRef, int k) {
    BTreeNode* r = *rootRef;
    if (r-&gt;n == 2 * r-&gt;t - 1) {
        BTreeNode* s = createNode(r-&gt;t, false);
        s-&gt;C[0] = r;
        splitChild(s, 0);
        int i = (k &gt; s-&gt;keys[0]) ? 1 : 0;
        insertNonFull(s-&gt;C[i], k);
        *rootRef = s;
    } else {
        insertNonFull(r, k);
    }
}

// Get predecessor
int getPred(BTreeNode* x) {
    while (!x-&gt;leaf)
        x = x-&gt;C[x-&gt;n];
    return x-&gt;keys[x-&gt;n - 1];
}

// Get successor
int getSucc(BTreeNode* x) {
    while (!x-&gt;leaf)
        x = x-&gt;C[0];
    return x-&gt;keys[0];
}

// Merge two children
void merge(BTreeNode* x, int idx) {
    BTreeNode* c1 = x-&gt;C[idx];
    BTreeNode* c2 = x-&gt;C[idx + 1];
    int t = x-&gt;t;
    c1-&gt;keys[t - 1] = x-&gt;keys[idx];
    for (int i = 0; i &lt; c2-&gt;n; ++i)
        c1-&gt;keys[i + t] = c2-&gt;keys[i];
    if (!c1-&gt;leaf) {
        for (int i = 0; i &lt;= c2-&gt;n; ++i)
            c1-&gt;C[i + t] = c2-&gt;C[i];
    }
    for (int i = idx + 1; i &lt; x-&gt;n; ++i)
        x-&gt;keys[i - 1] = x-&gt;keys[i];
    for (int i = idx + 2; i &lt;= x-&gt;n; ++i)
        x-&gt;C[i - 1] = x-&gt;C[i];
    c1-&gt;n += c2-&gt;n + 1;
    x-&gt;n--;
    free(c2);
}

// Fill child if less than t-1 keys
void fill(BTreeNode* x, int idx) {
    int t = x-&gt;t;
    if (idx &gt; 0 &amp;&amp; x-&gt;C[idx - 1]-&gt;n &gt;= t) {
        BTreeNode* child = x-&gt;C[idx];
        BTreeNode* sibling = x-&gt;C[idx - 1];
        for (int i = child-&gt;n - 1; i &gt;= 0; --i)
            child-&gt;keys[i + 1] = child-&gt;keys[i];
        if (!child-&gt;leaf) {
            for (int i = child-&gt;n; i &gt;= 0; --i)
                child-&gt;C[i + 1] = child-&gt;C[i];
        }
        child-&gt;keys[0] = x-&gt;keys[idx - 1];
        if (!child-&gt;leaf)
            child-&gt;C[0] = sibling-&gt;C[sibling-&gt;n];
        x-&gt;keys[idx - 1] = sibling-&gt;keys[sibling-&gt;n - 1];
        child-&gt;n += 1;
        sibling-&gt;n -= 1;
    } else if (idx &lt; x-&gt;n &amp;&amp; x-&gt;C[idx + 1]-&gt;n &gt;= t) {
        BTreeNode* child = x-&gt;C[idx];
        BTreeNode* sibling = x-&gt;C[idx + 1];
        child-&gt;keys[child-&gt;n] = x-&gt;keys[idx];
        if (!child-&gt;leaf)
            child-&gt;C[child-&gt;n + 1] = sibling-&gt;C[0];
        x-&gt;keys[idx] = sibling-&gt;keys[0];
        for (int i = 1; i &lt; sibling-&gt;n; ++i)
            sibling-&gt;keys[i - 1] = sibling-&gt;keys[i];
        if (!sibling-&gt;leaf) {
            for (int i = 1; i &lt;= sibling-&gt;n; ++i)
                sibling-&gt;C[i - 1] = sibling-&gt;C[i];
        }
        child-&gt;n += 1;
        sibling-&gt;n -= 1;
    } else {
        if (idx != x-&gt;n)
            merge(x, idx);
        else
            merge(x, idx - 1);
    }
}

// Remove key from tree
void removeFromNode(BTreeNode* x, int k) {
    int idx = 0;
    while (idx &lt; x-&gt;n &amp;&amp; x-&gt;keys[idx] &lt; k)
        ++idx;
    if (idx &lt; x-&gt;n &amp;&amp; x-&gt;keys[idx] == k) {
        if (x-&gt;leaf) {
            for (int i = idx + 1; i &lt; x-&gt;n; ++i)
                x-&gt;keys[i - 1] = x-&gt;keys[i];
            x-&gt;n--;
        } else {
            if (x-&gt;C[idx]-&gt;n &gt;= x-&gt;t) {
                int pred = getPred(x-&gt;C[idx]);
                x-&gt;keys[idx] = pred;
                removeFromNode(x-&gt;C[idx], pred);
            } else if (x-&gt;C[idx + 1]-&gt;n &gt;= x-&gt;t) {
                int succ = getSucc(x-&gt;C[idx + 1]);
                x-&gt;keys[idx] = succ;
                removeFromNode(x-&gt;C[idx + 1], succ);
            } else {
                merge(x, idx);
                removeFromNode(x-&gt;C[idx], k);
            }
        }
    } else {
        if (x-&gt;leaf)
            return;
        bool flag = (idx == x-&gt;n);
        if (x-&gt;C[idx]-&gt;n &lt; x-&gt;t)
            fill(x, idx);
        if (flag &amp;&amp; idx &gt; x-&gt;n)
            removeFromNode(x-&gt;C[idx - 1], k);
        else
            removeFromNode(x-&gt;C[idx], k);
    }
}

// Delete key wrapper
void deleteKey(BTreeNode** rootRef, int k) {
    BTreeNode* r = *rootRef;
    removeFromNode(r, k);
    if (r-&gt;n == 0) {
        BTreeNode* tmp = r;
        if (r-&gt;leaf)
            *rootRef = NULL;
        else
            *rootRef = r-&gt;C[0];
        free(tmp);
    }
}

// Main function with test case support
int main() {
    int t;
    scanf("%d", &amp;t);
    BTreeNode* root = createNode(t, true);
    int n, val;
    scanf("%d", &amp;n);
    for (int i = 0; i &lt; n; i++) {
        scanf("%d", &amp;val);
        insert(&amp;root, val);
    }
    inorder(root);
    int d;
    scanf("%d", &amp;d);
    for (int i = 0; i &lt; d; i++) {
        scanf("%d", &amp;val);
        deleteKey(&amp;root, val);
    }
    inorder(root);
    int target;
    scanf("%d\n", &amp;target);
    if (search(root, target))
        printf("Found\n");
    else
        printf("Not Found\n");

    return 0;
}</pre><br data-ref="8c15b6ab-88ee-4aaa-953d-81ffa6033588"></div></div><div class="row" data-ref="7a47a51a-ea75-419b-8e6c-3e05c32d7988"><div class="col-12" data-ref="884e1bc9-d1b3-442c-80bb-9e436540e29a"><h5 class="execResultsHeading text-center" data-ref="3fa2fc57-6853-4417-9e24-ffe51de9fae7">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="a8cac921-7107-42ba-9374-bd43f3da074d" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="59fdaae7-a3a9-488f-b782-e0b20c5b0de9"><div class="row execution-results-border" data-ref="7f8b88b9-7d9d-425c-992c-a6ae16447fda"><div class="col-12 p-2 text-center font-weight-bold" data-ref="2d0f9c7b-59fc-4e31-a443-e8099ff44692">Test Case - 1</div></div><div class="row execution-results-border" data-ref="1338d994-fba6-4d83-98da-9019090aa377"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="6b322b1f-c27c-4bb3-b379-15e6ebcd8678">User Output</div></div><div class="row execution-results-border" data-ref="a50800a7-be4f-48e6-b6f5-c0de20b9fc97"><div class="col-6" data-ref="aaf85440-f2e6-4520-a187-40f046227507"><span class="cmd" title="User Input" data-ref="aa2acdcf-fa30-44a2-be50-2fb7f97e084f">2</span></div></div><div class="row execution-results-border" data-ref="407499a1-9f10-4c6e-8c55-7eafbd2a0e20"><div class="col-6" data-ref="86112d4e-92ff-4ec4-8797-1878406f01c7"><span class="cmd" title="User Input" data-ref="81e99856-515c-4ef9-80e6-61af8fbaa4c6">7</span></div></div><div class="row execution-results-border" data-ref="70477c8b-79df-49f9-817f-d0896e8d3f4a"><div class="col-6" data-ref="1924f93f-cef1-4aee-bf55-98654741cbe2"><span class="cmd" title="User Input" data-ref="debdee08-c98c-4fa4-b290-352db6f64529">10 20 5 6 12 30 7</span></div></div><div class="row execution-results-border" data-ref="2d202433-9c4b-4dd3-90fe-155b2f163929"><div class="col-6" data-ref="bc753f70-c8d6-4d51-8d7d-3e1c2ee61d8b"><span class="cmd" title="User In