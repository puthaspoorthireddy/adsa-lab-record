order.</li></ul></span></div><div class="mb-3" data-ref="43dfa029-63f1-41a3-bb94-e6d91c21a550"><div class="ml-1 mb-3" data-ref="921a00f7-da71-49a4-a8f1-194bbea3fbe9"><b style="border-bottom:1px solid black;" data-ref="e6c452a4-b7fe-4eff-af62-732d4fac9e98" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="79807e0f-7fc9-4b97-934b-8771fdd92ffa" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="cd5d8fbd-b8ab-43cb-8a84-beba319d500c" data-undisplayed="undisplayed">CTC64721.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="5ce888ca-4b64-4f0f-ae55-dada127a741b" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#define MAX 10
int adj[MAX][MAX];   // Adjacency matrix
int visited[MAX];    // Visited array
int queue[MAX];      // Queue for BFS
int front = 0, rear = 0;
int n;               // Number of vertices
// Enqueue function
void enqueue(int vertex) {
    queue[rear++] = vertex;
}
// Dequeue function
int dequeue() {
    return queue[front++];
}
// Check if queue is empty
int isEmpty() {
    return front == rear;
}
// Breadth First Search function
void bfs(int start) {
    visited[start] = 1;
    enqueue(start);
    while (!isEmpty()) {
        int current = dequeue();
        printf("%d ", current);
        // Traverse neighbors in increasing order
        for (int i = 0; i &lt; n; i++) {
            if (adj[current][i] == 1 &amp;&amp; !visited[i]) {
                visited[i] = 1;
                enqueue(i);
            }
        }
    }
}
int main() {
    int edges, u, v, start;
    // Input number of vertices
    scanf("%d", &amp;n);
    // Input number of edges
    scanf("%d", &amp;edges);
    // Initialize adjacency matrix and visited array
    for (int i = 0; i &lt; n; i++) {
        visited[i] = 0;
        for (int j = 0; j &lt; n; j++) {
            adj[i][j] = 0;
        }
    }
    // Read edges and update matrix
    for (int i = 0; i &lt; edges; i++) {
        scanf("%d %d", &amp;u, &amp;v);
        adj[u][v] = 1;
        adj[v][u] = 1; // Undirected graph
    }
    // Input starting vertex
    scanf("%d", &amp;start);
    // Perform BFS
    bfs(start);
    return 0;
}</pre><br data-ref="09397d5a-e7df-4174-b388-ae8a828a215c"></div></div><div class="row" data-ref="76fa8ea1-1e76-4c06-866f-77489bf5663e"><div class="col-12" data-ref="832993dd-54f2-4e03-a226-2752e634090a"><h5 class="execResultsHeading text-center" data-ref="7dbf908a-f2a4-47ba-bea2-7e40a9ece14d">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="f14d0411-4129-4bba-b71c-c67e037e80d6" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="6edaa011-e580-4fe0-8e1f-e1d74ce466aa"><div class="row execution-results-border" data-ref="cc97943f-4a84-4e22-ae3d-1c662ee609ab"><div class="col-12 p-2 text-center font-weight-bold" data-ref="67749af1-79d7-445b-9597-5f30fbe220bd">Test Case - 1</div></div><div class="row execution-results-border" data-ref="c168a466-25db-4224-bc20-18451944e614"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="9d92587e-42f7-4435-b390-ce1b23bcd8b0">User Output</div></div><div class="row execution-results-border" data-ref="18f8fc2c-5794-4cd2-ba74-fccab2d53d39"><div class="col-6" data-ref="521a5e93-6b62-4b8c-897f-dff9206433ed"><span class="cmd" title="User Input" data-ref="e6fa5b57-df60-482a-af1d-ca69fbe99852">4</span></div></div><div class="row execution-results-border" data-ref="acc80dce-b676-470f-984b-c8ef8fbddef3"><div class="col-6" data-ref="a55846e9-cb08-462d-9396-5840d4ffdc0d"><span class="cmd" title="User Input" data-ref="03630a56-0446-41a3-b662-f831f2bb3580">4</span></div></div><div class="row execution-results-border" data-ref="0dffbf0a-7344-41c0-9141-b3841b151ab7"><div class="col-6" data-ref="24f2b83a-7e6c-493c-8d0b-2e0a213b5cdf"><span class="cmd" title="User Input" data-ref="58b0c99f-bdb5-4c24-abf9-b49d82226177">0 1</span></div></div><div class="row execution-results-border" data-ref="f8bfce8f-1c0a-4db0-8383-35f274c4ef65"><div class="col-6" data-ref="a63b9477-5698-4a4f-b743-d7fbb6178b96"><span class="cmd" title="User Input" data-ref=